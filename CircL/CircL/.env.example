# Database
MONGODB_URI=mongodb://localhost:27017/circl
DB_NAME=circl

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# Cloudinary (Optional for media storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Email (Optional for notifications)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@circl.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Socket.IO
SOCKET_RECONNECT_DELAY=1000
SOCKET_RECONNECT_DELAY_MAX=5000
SOCKET_RECONNECT_ATTEMPTS=5

# Room Expiry Job
ROOM_EXPIRY_CHECK_INTERVAL=60000

# Reputation System
MIN_REPUTATION_FOR_PRIVATE_CHAT=0
